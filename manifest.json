{
  "manifest_version": 3,
  "name": "Dominion Navigator",
  "version": "0.1.0",
  "description": "Tracks visible Dominion Online card locations from the in-page game model.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://dominion.games/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-probe.js"],
      "matches": ["https://dominion.games/*"]
    }
  ]
}
